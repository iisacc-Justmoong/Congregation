# Resolve existing ancestors before creating the final directory. This rejects
# symlink escapes without asking REAL_PATH to resolve a path that does not exist.
function(congregation_test_resource_directory resource_root requested base_directory output)
    file(REAL_PATH "${resource_root}" root)
    cmake_path(ABSOLUTE_PATH requested BASE_DIRECTORY "${base_directory}" NORMALIZE OUTPUT_VARIABLE absolute)
    cmake_path(GET absolute PARENT_PATH parent)
    cmake_path(GET absolute FILENAME name)
    if(name STREQUAL "" OR NOT IS_DIRECTORY "${parent}")
        message(FATAL_ERROR "The parent of native test resources must already exist")
    endif()
    file(REAL_PATH "${parent}" parent_real)
    cmake_path(IS_PREFIX root "${parent_real}" NORMALIZE contained)
    if(NOT contained)
        message(FATAL_ERROR "Native test resources must be inside the project resources directory")
    endif()
    set(destination "${parent_real}/${name}")
    if(IS_SYMLINK "${destination}" AND NOT EXISTS "${destination}")
        message(FATAL_ERROR "Native test resources cannot be a dangling link")
    endif()
    if(EXISTS "${destination}")
        file(REAL_PATH "${destination}" resolved)
        cmake_path(IS_PREFIX root "${resolved}" NORMALIZE contained)
        if(NOT contained OR resolved STREQUAL root OR NOT IS_DIRECTORY "${resolved}")
            message(FATAL_ERROR "Native test resources must resolve to a directory inside resources")
        endif()
    else()
        file(MAKE_DIRECTORY "${destination}")
        file(REAL_PATH "${destination}" resolved)
        cmake_path(IS_PREFIX root "${resolved}" NORMALIZE contained)
        if(NOT contained OR resolved STREQUAL root)
            message(FATAL_ERROR "Native test resources resolve outside the project resources directory")
        endif()
    endif()
    set(${output} "${resolved}" PARENT_SCOPE)
endfunction()

# Tests use the real resource directory; this convenience link is optional
# on systems where a user cannot create symbolic links.
function(congregation_optional_resource_link target link)
    if(NOT EXISTS "${link}" AND NOT IS_SYMLINK "${link}")
        file(CREATE_LINK "${target}" "${link}" SYMBOLIC RESULT link_result)
    endif()
endfunction()
