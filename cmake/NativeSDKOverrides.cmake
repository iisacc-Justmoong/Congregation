function(congregation_override_native_package prefix package)
    if("${prefix}" STREQUAL "")
        return()
    endif()
    set(package_dir "${prefix}/lib/cmake/${package}")
    if(NOT EXISTS "${package_dir}/${package}Config.cmake")
        message(FATAL_ERROR "Selected ${package} SDK package is missing: ${package_dir}")
    endif()
    set(${package}_DIR "${package_dir}" CACHE PATH "Selected native SDK package" FORCE)
endfunction()
