# Inspect link items as well as target names: dependencies may arrive through
# imported locations, link options or generator expressions instead of a direct
# find_package call.  A similar non-LVRS name such as LVRSCompatible is valid.
function(congregation_is_legacy_native_dependency value result)
    string(TOLOWER "${value}" candidate)
    if(candidate MATCHES "(^|[^a-z0-9_])(-l)?(lib)?qt[a-z0-9_]*(::|[./_:-]|$)" OR
       candidate MATCHES "(^|[^a-z0-9_])(-l)?(lib)?lvrs(::|[./_:-]|$|(core|native|plugin)[a-z0-9_]*(::|[./_:-]|$))")
        set(${result} TRUE PARENT_SCOPE)
    else()
        set(${result} FALSE PARENT_SCOPE)
    endif()
endfunction()

function(congregation_reject_legacy_native_dependency value context)
    congregation_is_legacy_native_dependency("${value}" forbidden)
    if(forbidden)
        message(FATAL_ERROR "Native Congregation reaches ${value} through ${context}")
    endif()
    if(IS_ABSOLUTE "${value}" AND EXISTS "${value}")
        file(REAL_PATH "${value}" resolved)
        congregation_is_legacy_native_dependency("${resolved}" forbidden)
        if(forbidden)
            message(FATAL_ERROR "Native Congregation reaches ${resolved} via ${value} through ${context}")
        endif()
    endif()
endfunction()

function(congregation_verify_native_engine)
    set(_native_pending CongregationArtwork)
    if(TARGET Congregation)
        list(APPEND _native_pending Congregation)
    endif()
    set(_native_seen)
    while(_native_pending)
        list(POP_FRONT _native_pending _target)
        if(_target IN_LIST _native_seen OR NOT TARGET "${_target}")
            continue()
        endif()
        congregation_reject_legacy_native_dependency("${_target}" "target graph")
        list(APPEND _native_seen "${_target}")
        get_target_property(_alias "${_target}" ALIASED_TARGET)
        if(_alias AND TARGET "${_alias}")
            list(APPEND _native_pending "${_alias}")
        endif()
        get_target_property(_imported "${_target}" IMPORTED)
        if(_imported)
            get_target_property(_configs "${_target}" IMPORTED_CONFIGURATIONS)
            if(_configs STREQUAL "_configs-NOTFOUND")
                set(_configs)
            endif()
            set(_locations IMPORTED_LOCATION IMPORTED_IMPLIB IMPORTED_SONAME)
            foreach(_config IN ITEMS DEBUG RELEASE RELWITHDEBINFO MINSIZEREL NOCONFIG ${_configs})
                string(TOUPPER "${_config}" _config)
                foreach(_name IN ITEMS IMPORTED_LOCATION IMPORTED_IMPLIB IMPORTED_SONAME)
                    list(APPEND _locations "${_name}_${_config}")
                endforeach()
            endforeach()
            list(REMOVE_DUPLICATES _locations)
            foreach(_property IN LISTS _locations)
                get_target_property(_location "${_target}" "${_property}")
                if(_location AND NOT _location MATCHES "-NOTFOUND$")
                    congregation_reject_legacy_native_dependency("${_location}" "${_target}.${_property}")
                endif()
            endforeach()
        endif()
        foreach(_property LINK_LIBRARIES INTERFACE_LINK_LIBRARIES LINK_OPTIONS INTERFACE_LINK_OPTIONS)
            get_target_property(_links "${_target}" "${_property}")
            if(_links STREQUAL "_links-NOTFOUND")
                continue()
            endif()
            foreach(_link IN LISTS _links)
                congregation_reject_legacy_native_dependency("${_link}" "${_target}.${_property}")
                if(TARGET "${_link}")
                    list(APPEND _native_pending "${_link}")
                endif()
                # Conservatively traverse target names in every generator-expression
                # branch, including unnamespaced targets hidden by LINK_ONLY/IF.
                string(REGEX MATCHALL "[A-Za-z_][A-Za-z0-9_.+-]*(::[A-Za-z_][A-Za-z0-9_.+-]*)?" _references "${_link}")
                foreach(_reference IN LISTS _references)
                    if(TARGET "${_reference}")
                        list(APPEND _native_pending "${_reference}")
                    endif()
                endforeach()
            endforeach()
        endforeach()
    endwhile()
    file(WRITE "${CMAKE_BINARY_DIR}/native-engine-targets.txt" "${_native_seen}\n")
    file(GLOB_RECURSE _sources CONFIGURE_DEPENDS "${CMAKE_SOURCE_DIR}/App/Engine/*.cpp" "${CMAKE_SOURCE_DIR}/App/Engine/*.h" "${CMAKE_SOURCE_DIR}/App/Native/*.cpp" "${CMAKE_SOURCE_DIR}/App/Native/*.h")
    foreach(_source IN LISTS _sources)
        file(READ "${_source}" _text)
        if(_text MATCHES "#[ \t]*include[ \t]*[<\"](Qt|Q[A-Z]|LVRS/)" OR
           _text MATCHES "(^|[^A-Za-z0-9_])lvrs::")
            message(FATAL_ERROR "Qt or LVRS in native source: ${_source}")
        endif()
    endforeach()
endfunction()

# The parent project can add links after including this file. Inspect only
# after that directory has finished configuring so those links are included.
cmake_language(DEFER CALL congregation_verify_native_engine)
