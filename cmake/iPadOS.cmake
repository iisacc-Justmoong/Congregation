# One canonical app for the selected Apple platform, including all Xcode configs.
function(congregation_configure_ipados target)
    set(CONGREGATION_APPLE_TEAM "5U49ST9XZH" CACHE STRING "Apple development team")
    set_target_properties(${target} PROPERTIES
        MACOSX_BUNDLE_INFO_PLIST "${CMAKE_SOURCE_DIR}/packaging/ios/Info.plist.in"
        MACOSX_BUNDLE_ICON_FILE ""
        RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}"
        RUNTIME_OUTPUT_DIRECTORY_RELEASE "${CMAKE_BINARY_DIR}"
        RUNTIME_OUTPUT_DIRECTORY_DEBUG "${CMAKE_BINARY_DIR}"
        XCODE_ATTRIBUTE_CONFIGURATION_BUILD_DIR "${CMAKE_BINARY_DIR}"
        XCODE_ATTRIBUTE_PRODUCT_BUNDLE_IDENTIFIER "com.iisacc.congregation.painter"
        XCODE_ATTRIBUTE_DEVELOPMENT_TEAM "${CONGREGATION_APPLE_TEAM}"
        XCODE_ATTRIBUTE_CODE_SIGN_STYLE Automatic
        XCODE_ATTRIBUTE_CODE_SIGN_IDENTITY "Apple Development"
        XCODE_ATTRIBUTE_TARGETED_DEVICE_FAMILY "2"
        XCODE_ATTRIBUTE_IPHONEOS_DEPLOYMENT_TARGET "18.0"
        XCODE_ATTRIBUTE_SUPPORTED_PLATFORMS "iphoneos"
        XCODE_ATTRIBUTE_ASSETCATALOG_COMPILER_APPICON_NAME AppIcon
        XCODE_ATTRIBUTE_SKIP_INSTALL YES
        XCODE_ATTRIBUTE_ENABLE_USER_SCRIPT_SANDBOXING NO
        XCODE_ATTRIBUTE_LD_RUNPATH_SEARCH_PATHS "@executable_path/Frameworks"
        XCODE_ATTRIBUTE_ENABLE_BITCODE NO)
    target_link_options(${target} PRIVATE -ObjC)
endfunction()
