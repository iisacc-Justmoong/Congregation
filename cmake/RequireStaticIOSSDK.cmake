function(congregation_require_static_ios_sdk target)
    if(NOT TARGET "${target}")
        message(FATAL_ERROR "The iPadOS SDK target is missing: ${target}")
    endif()
    get_target_property(_type "${target}" TYPE)
    if(NOT _type STREQUAL "STATIC_LIBRARY")
        message(FATAL_ERROR "The iPadOS app requires a static ${target} package")
    endif()
endfunction()
