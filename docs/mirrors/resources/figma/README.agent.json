    {
      "id": "b000003",
      "kind": "paragraph",
      "start_line": 3,
      "end_line": 3,
      "raw": "These individual content assets were exported from the Congregation design owned by the project. Their provenance and SHA-256 digests are recorded in `sources.json`.\n"
    },
    {
      "id": "b000004",
      "kind": "blank",
      "start_line": 4,
      "end_line": 4,
      "raw": "\n"
    },
    {
