#include <windows.h>

IDI_ICON1 ICON "@CONGREGATION_WINDOWS_APP_ICON_RC@"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@CONGREGATION_WINDOWS_MANIFEST_RC@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @CONGREGATION_WINDOWS_VERSION_COMMA@
 PRODUCTVERSION @CONGREGATION_WINDOWS_VERSION_COMMA@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Congregation raster drawing application\0"
            VALUE "FileVersion", "@CONGREGATION_WINDOWS_VERSION_DOTTED@\0"
            VALUE "InternalName", "Congregation\0"
            VALUE "OriginalFilename", "Congregation.exe\0"
            VALUE "ProductName", "Congregation\0"
            VALUE "ProductVersion", "@CONGREGATION_WINDOWS_VERSION_DOTTED@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
