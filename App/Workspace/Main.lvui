                        IconButton(id: "command-symmetry-paint", iconName: "symmetry-paint", accessibilityName: "symmetry-paint", tone: .borderless, onClick: vm.symmetry_paint) {},
                        IconButton(id: "command-grid", iconName: "grid", accessibilityName: "grid", tone: .borderless, onClick: vm.toggle_grid) {},
                        IconButton(id: "command-rulers", iconName: "rulers", accessibilityName: "rulers", tone: .borderless, onClick: vm.toggle_rulers) {},
                        IconButton(id: "command-snap", iconName: "snap", accessibilityName: "snap", tone: .borderless, onClick: vm.toggle_snap) {},
                        Spacer() {},
                        ComboBox(id: "document-color-mode", text: "sRGB / 8-bit", tone: .borderless, arrow: .down, width: Metric.size160, onClick: vm.show_document_options) {},
                        IconButton(id: "brush-color", iconName: "color-picker", accessibilityName: "color-picker", tone: .borderless, onClick: vm.open_color) {},
                        IconButton(id: "export", visible: !vm.custom_titlebar_visible, iconName: "generalexport", accessibilityName: "generalexport", tone: .borderless, onClick: vm.export_document) {},
                        IconButton(id: "preferences", visible: !vm.custom_titlebar_visible, iconName: "settings", accessibilityName: "settings", tone: .borderless, onClick: vm.preferences) {},
                    },
                    VStack(width: Metric.space4) {},
                },
                MenuDivider(thickness: Metric.stroke1, crossPadding: Metric.space0, dividerColor: Color.canvas) {},
            },
            HStack(id: "workspace-body", spacing: Metric.space0, alignment: .stretch, flex: 1) {
                HStack(id: "tool-rail", visible: vm.chrome_visible, width: 2 * vm.tool_button_extent + Metric.space2 + 2 * Metric.space4, spacing: Metric.space0, alignment: .stretch) {
                    VStack(width: 2 * vm.tool_button_extent + Metric.space2 + 2 * Metric.space4 - Metric.stroke1, spacing: Metric.space2, padding: Metric.space4, alignment: .stretch) {
                        HStack(spacing: Metric.space2, alignment: .center) {
                            IconButton(id: "select", iconName: "move", accessibilityName: "move", tone: .borderless, checked: vm.selected_tool == "move", pointerFocusVisible: false, onClick: vm.choose_tool_move) {},
                            IconButton(id: "tool-rect-marquee", iconName: "rect-marquee", accessibilityName: "rect-marquee", tone: .borderless, checked: vm.selected_tool == "rect-marquee", pointerFocusVisible: false, onClick: vm.choose_tool_rect_marquee) {},
                        },
                        HStack(spacing: Metric.space2, alignment: .center) {
                            IconButton(id: "tool-ellipse-marquee", iconName: "ellipse-marquee", accessibilityName: "ellipse-marquee", tone: .borderless, checked: vm.selected_tool == "ellipse-marquee", pointerFocusVisible: false, onClick: vm.choose_tool_ellipse_marquee) {},
                            IconButton(id: "tool-lasso", iconName: "lasso", accessibilityName: "lasso", tone: .borderless, checked: vm.selected_tool == "lasso", pointerFocusVisible: false, onClick: vm.choose_tool_lasso) {},
                        },
                        HStack(spacing: Metric.space2, alignment: .center) {
                            IconButton(id: "tool-polygon-lasso", iconName: "polygon-lasso", accessibilityName: "polygon-lasso", tone: .borderless, checked: vm.selected_tool == "polygon-lasso", pointerFocusVisible: false, onClick: vm.choose_tool_polygon_lasso) {},
