            MenuItem(id: "new-layer-line-art", label: "Line art…", keyVisible: false, showChevron: false, onClick: vm.new_layer_line_art) {},
            MenuItem(id: "new-layer-canny", label: "Canny…", keyVisible: false, showChevron: false, onClick: vm.new_layer_canny) {},
            MenuItem(id: "new-layer-scribble", label: "Scribble…", keyVisible: false, showChevron: false, onClick: vm.new_layer_scribble) {},
            MenuItem(id: "new-layer-mlsd", label: "MLSD…", keyVisible: false, showChevron: false, onClick: vm.new_layer_mlsd) {},
            MenuItem(id: "new-layer-normal-map", label: "Normal map…", keyVisible: false, showChevron: false, onClick: vm.new_layer_normal_map) {},
            MenuItem(id: "new-layer-shuffle", label: "Shuffle…", keyVisible: false, showChevron: false, onClick: vm.new_layer_shuffle) {},
            MenuItem(id: "new-layer-tile", label: "Tile…", keyVisible: false, showChevron: false, onClick: vm.new_layer_tile) {},
            MenuItem(id: "new-layer-reference", label: "Reference…", keyVisible: false, showChevron: false, onClick: vm.new_layer_reference) {},
            MenuItem(id: "new-layer-ip-adapter", label: "IP-Adapter…", keyVisible: false, showChevron: false, onClick: vm.new_layer_ip_adapter) {},
        },
        ContextMenu(id: "layer-menu", itemWidth: Metric.size180) {
            MenuItem(keyVisible: false, showChevron: false, label: "Add layer", onClick: vm.add_layer) {},
            MenuItem(keyVisible: false, showChevron: false, id: "menu-duplicate-layer", label: "Duplicate layer", onClick: vm.duplicate_layer) {},
            MenuItem(keyVisible: false, showChevron: false, label: "Delete layer", onClick: vm.delete_layer) {},
            MenuItem(keyVisible: false, showChevron: false, label: "Show / hide layer", onClick: vm.toggle_layer_visibility) {},
            MenuDivider() {},
            MenuItem(keyVisible: false, showChevron: false, label: "Place image…", onClick: vm.image) {},
        },
        Popover(id: "color-popup", width: Metric.size320, height: Metric.size320, padding: Metric.space20, surfaceColor: Color.surfaceSolid, cornerRadius: Metric.radius8) {
            ColorPickerSurface(id: "color-editor", model: vm.color_source, modelRevision: vm.color_revision, field: .wheel, width: Metric.size280, height: Metric.size280, onColorEdited: vm.color_edited) {},
        },
        Popover(id: "agent-popup", width: Metric.size360, height: Metric.size240, padding: Metric.space12, accessibilityName: "Society workspace agent") {
            VStack(spacing: Metric.space8, alignment: .stretch) {
                HStack(alignment: .center) {
                    Label(text: "Agent · Society workspace", fontSize: Metric.textBody, fontWeight: Metric.weightSemiBold) {},
                    Spacer() {},
                    LabelButton(id: "agent-close", text: "Close", tone: .borderless, onClick: vm.close_agent) {},
                },
                Label(id: "agent-status", text: vm.agent_status, fontSize: Metric.textCaption) {},
                TextEditor(id: "agent-response", text: vm.agent_response, placeholder: "Society workspace response", readOnly: true, wrapEnabled: true,
                           width: Metric.size360 - 2 * Metric.space12, height: Metric.size160, accessibilityName: "Agent response") {},
            },
        },
        Popover(id: "status-notice", width: Metric.size420, height: Metric.size98, padding: Metric.space12, focus: false, clip: true, surfaceColor: Color.surfaceSolid, accessibilityName: "Canvas error") {
            HStack(spacing: Metric.space8, alignment: .center) {
                Label(text: vm.status, flex: 1) {},
                LabelButton(text: "×", tone: .borderless, height: Metric.size22, horizontalPadding: Metric.space4, accessibilityName: "Dismiss message", onClick: vm.close_notice) {},
            },
        },
        Popover(id: "text-popup", width: Metric.size320, height: Metric.size118, padding: Metric.space12, surfaceColor: Color.surfaceSolid, cornerRadius: Metric.radius8) {
            VStack(spacing: Metric.space8) {
                Label(text: "Text", fontSize: Metric.textBody, fontWeight: Metric.weightSemiBold) {},
                InputField(id: "text-value", multiline: true, height: Metric.size64, text: vm.text_value, placeholder: "Text to place", width: Metric.size320 - 2 * Metric.space12, onEdited: vm.set_text) {},
            },
        },
        Popover(id: "brush-popup", width: Metric.size340, height: Metric.size574) {
            ScrollView(id: "brush-scroll", width: Metric.size340 - 2 * Metric.space12, height: Metric.size574 - 2 * Metric.space12) {
                VStack(spacing: Metric.space4, alignment: .stretch) {
                    Label(text: "Brush", style: .body) {},
                    VStack(spacing: Metric.space4, alignment: .stretch) {
                        HStack() {
                            Label(text: "Size") {},
                            Spacer() {},
                            Label(text: vm.size_label) {},
                        },
                        Slider(id: "brush-size-popup", from: 1, to: vm.brush_size_limit, value: vm.brush_size, width: Metric.size340 - 2 * Metric.space12, size: .mini, onMoved: vm.set_brush_size) {},
                    },
                    VStack(spacing: Metric.space4, alignment: .stretch) {
                        HStack() {
                            Label(text: "Flow") {},
                            Spacer() {},
                            Label(text: vm.flow_label) {},
                        },
                        Slider(id: "brush-flow-popup", from: 0, to: 1, value: vm.flow, width: Metric.size340 - 2 * Metric.space12, size: .mini, onMoved: vm.set_flow) {},
                    },
                    VStack(spacing: Metric.space4, alignment: .stretch) {
                        HStack() {
                            Label(text: "Opacity") {},
                            Spacer() {},
                            Label(text: vm.opacity_label) {},
                        },
                        Slider(id: "brush-opacity-popup", from: 0, to: 1, value: vm.opacity, width: Metric.size340 - 2 * Metric.space12, size: .mini, onMoved: vm.set_opacity) {},
                    },
                    HStack(alignment: .center) {
                        Label(text: "Pressure Opacity", flex: 1) {},
                        ToggleSwitch(checked: vm.pressure_enabled, onToggled: vm.set_pressure_enabled) {},
                    },
                    VStack(spacing: Metric.space4, alignment: .stretch) {
                        HStack() {
                            Label(text: "Hardness") {},
                            Spacer() {},
                            Label(text: vm.hardness_label) {},
                        },
                        Slider(id: "brush-hardness-popup", from: 0.01, to: 1, value: vm.hardness, width: Metric.size340 - 2 * Metric.space12, size: .mini, onMoved: vm.set_hardness) {},
                    },
                    VStack(spacing: Metric.space4, alignment: .stretch) {
                        HStack() {
                            Label(text: "Spacing") {},
                            Spacer() {},
                            Label(text: vm.spacing_label) {},
                        },
                        Slider(id: "brush-spacing-popup", from: 0, to: 64, value: vm.spacing_pixels, width: Metric.size340 - 2 * Metric.space12, size: .mini, onMoved: vm.set_spacing_pixels) {},
                    },
                    VStack(spacing: Metric.space4, alignment: .stretch) {
                        HStack() {
                            Label(text: "Spacing Ratio") {},
                            Spacer() {},
                            Label(text: vm.spacing_ratio_label) {},
                        },
                        Slider(id: "brush-spacing-ratio-popup", from: 0, to: 1, value: vm.spacing, width: Metric.size340 - 2 * Metric.space12, size: .mini, onMoved: vm.set_spacing) {},
                    },
                    VStack(spacing: Metric.space4, alignment: .stretch) {
                        HStack() {
                            Label(text: "Smoothing Strength") {},
                            Spacer() {},
                            Label(text: vm.stabilizer_label) {},
                        },
                        Slider(id: "brush-stabilizer-popup", from: 0, to: 1, value: vm.stabilizer, width: Metric.size340 - 2 * Metric.space12, size: .mini, onMoved: vm.set_stabilizer) {},
                    },
                    VStack(spacing: Metric.space4, alignment: .stretch) {
                        Label(text: "Pressure Curve") {},
                        EventListener(id: "pressure-curve", width: Metric.size340 - 2 * Metric.space12, height: Metric.size92, onInput: vm.pressure_curve_input) {},
                        HStack() {
                            Label(text: "Pressure Minimum", style: .caption) {},
                            Spacer() {},
                            Label(text: vm.pressure_min_label, style: .caption) {},
                        },
                        HStack() {
                            Label(text: "Pressure Center", style: .caption) {},
                            Spacer() {},
                            Label(text: vm.pressure_mid_label, style: .caption) {},
                        },
                        HStack() {
                            Label(id: "pressure-maximum-label", text: "Pressure Maximum", style: .caption) {},
                            Spacer() {},
                            Label(text: vm.pressure_max_label, style: .caption) {},
                        },
                    },
                },
            },
        },
    },
}
