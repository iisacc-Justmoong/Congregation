import vm congregation.ui.EditorBackend
import host congregation.native.NativeViewBackend

ApplicationWindow(title: "Congregation", windowChrome: .custom, width: Metric.windowWidth, height: Metric.windowHeight, minimumWidth: Metric.windowMinimumWidth, minimumHeight: Metric.windowMinimumHeight) {
    VStack(id: "activation-shell", spacing: Metric.space0, alignment: .stretch, flex: 1) {
        HStack(id: "application-titlebar", visible: vm.custom_titlebar_visible, height: Metric.space40,
               spacing: Metric.space4, padding: Metric.space8, alignment: .center) {
            HStack(id: "native-window-controls-space", visible: vm.native_titlebar_controls,
                   width: 2 * Metric.size32 - Metric.space2, height: Metric.size24) {},
            HStack(id: "client-window-controls", visible: vm.client_titlebar_controls, spacing: Metric.space0, alignment: .center) {
                IconButton(id: "window-close", iconName: "generalclose", accessibilityName: "Close window", tone: .borderless, onClick: vm.titlebar_close) {},
                IconButton(id: "window-minimize", iconName: "minus", accessibilityName: "Minimize window", tone: .borderless, onClick: vm.titlebar_minimize) {},
                IconButton(id: "window-maximize", iconName: "expand", accessibilityName: "Maximize or restore window", tone: .borderless, onClick: vm.titlebar_maximize) {},
            },
            EventListener(id: "titlebar-drag-region", flex: 1, height: Metric.size24, onInput: vm.titlebar_input) {},
            InputField(id: "titlebar-agent", text: vm.agent_prompt, placeholder: "Agent", width: Metric.size400 - Metric.size32 - Metric.space4,
                       height: Metric.size22, size: .compact, surface: .rounded, onEdited: vm.set_agent_prompt, onSubmit: vm.submit_agent) {},
            HStack(spacing: Metric.space2, alignment: .center) {
                IconButton(id: "titlebar-notifications", iconName: "toolwindownotifications", accessibilityName: "Notifications", tone: .borderless, onClick: vm.show_notifications) {},
                IconButton(id: "titlebar-learn", iconName: "toolwindowlearn", accessibilityName: "Learn", tone: .borderless, onClick: vm.show_learning) {},
                IconButton(id: "titlebar-export", iconName: "generalexport", accessibilityName: "Export", tone: .borderless, onClick: vm.export_document) {},
                IconButton(id: "titlebar-settings", iconName: "settings", accessibilityName: "Settings", tone: .borderless, onClick: vm.preferences) {},
            },
            EventListener(id: "titlebar-profile", sizeToContent: true, onInput: vm.titlebar_profile_input) {
                Avatar(size: .small, source: vm.profile_avatar, accessibilityName: "Account") {},
            },
        },
        Sheet(id: "activation", open: vm.needs_license, presentation: .desktop,
              showHeader: false, showCloseButton: false, scrollContent: true,
              preferredWidth: Metric.size540, preferredHeight: Metric.size340, contentPadding: Metric.space16,
              backdropColor: Color.material.overlay.scrim, accessibilityName: vm.account_title, motionEnabled: false,
              dismissOnBackground: false, dismissOnEscape: false, dismissOnDrag: false) {
            VStack(spacing: Metric.space12, alignment: .stretch) {
                Label(text: vm.account_title, fontSize: Metric.textTitle, fontWeight: Metric.weightSemiBold) {},
                Label(text: vm.account_description, fontSize: Metric.textBody) {},
                HStack(spacing: Metric.space12) {
                    Label(text: "Account") {},
                    Spacer() {},
                    Label(text: vm.account_email, fontSize: Metric.textBody) {},
                },
                Label(text: "Congregation is free. Your account is used to verify access.") {},
                Label(id: "account-status", text: vm.account_status) {},
                PushButton(id: "account-open-society", text: vm.account_button, onClick: vm.open_society) {},
                PushButton(id: "activate", text: "Check license", enabled: vm.can_activate, onClick: vm.restore_license) {},
                HStack(spacing: Metric.space8) {
                    PushButton(id: "cancel-sign-in", visible: vm.signing_in, text: "Cancel", onClick: vm.cancel_sign_in) {},
                },
            },
        },
        VStack(id: "workspace-screen", spacing: Metric.space0, alignment: .stretch, flex: 1) {
            VStack(id: "toolbar", visible: vm.chrome_visible, spacing: Metric.space0, height: Metric.toolbarHeight) {
                HStack(height: Metric.toolbarHeight - Metric.stroke1, spacing: Metric.space0, alignment: .stretch) {
                    VStack(width: Metric.space4) {},
                    HStack(spacing: Metric.space4, alignment: .center, flex: 1) {
                        IconButton(id: "open", iconName: "generalopen", accessibilityName: "generalopen", tone: .borderless, onClick: vm.open) {},
                        IconButton(id: "save", iconName: "generalsave", accessibilityName: "generalsave", tone: .borderless, onClick: vm.save) {},
                        IconButton(id: "undo", iconName: "generalundo", accessibilityName: "generalundo", tone: .borderless, onClick: vm.undo) {},
                        IconButton(id: "redo", iconName: "generalredo", accessibilityName: "generalredo", tone: .borderless, onClick: vm.redo) {},
                        ComboBox(id: "transform-mode", text: "Free transform", arrow: .down, width: Metric.size148, onClick: vm.select) {},
                        IconButton(id: "command-align-left", iconName: "align-left", accessibilityName: "align-left", tone: .borderless, onClick: vm.align_left) {},
                        IconButton(id: "command-align-center", iconName: "align-center", accessibilityName: "align-center", tone: .borderless, onClick: vm.align_center) {},
