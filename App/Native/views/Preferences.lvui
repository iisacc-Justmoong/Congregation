<script>
import vm congregation.ui.EditorBackend
</script>
<Window title="Preferences" width={Metric.size480} height={Metric.size360} minimumWidth={Metric.size480} minimumHeight={Metric.size360}>
  <div id="preferences-root" style="height: Metric.size360; display: flex; flex-direction: column; gap: Metric.space20; padding: Metric.space24; align-items: stretch; flex: 1">
    <div style="display: flex; flex-direction: row; align-items: center">
      <Spacer/>
      <LabelSegmentedControl spacing={Metric.space2} horizontalPadding={Metric.space2} verticalPadding={Metric.space2}>
        <LabelButton id="general-tab" text="General" height={Metric.size28} horizontalPadding={Metric.space12} tone={.borderless} onClick={vm.general_tab}/>
        <LabelButton id="profile-tab" text="Profile" height={Metric.size28} horizontalPadding={Metric.space12} tone={.borderless} onClick={vm.profile_tab}/>
        <LabelButton id="members-tab" text="Members" height={Metric.size28} horizontalPadding={Metric.space12} tone={.borderless} onClick={vm.members_tab}/>
      </LabelSegmentedControl>
      <Spacer/>
    </div>
    <div id="general-pane" visible={vm.general_visible} style="display: flex; flex-direction: column; gap: Metric.space12; align-items: stretch; flex: 1">
      <Label text="Account" fontSize={Metric.textDescription} color={Color.secondaryText}/>
      <div style="display: flex; flex-direction: row; gap: Metric.space8"><Label text={vm.account_email} fontSize={Metric.textBody}/><Spacer/><Button id="preferences-open-society" text="Open Society" height={Metric.size28} onClick={vm.open_society}/><Button text="Sign out" height={Metric.size28} visible={vm.signed_in} onClick={vm.forget_license}/></div>
      <Label text="Manage your account and licenses in Society." fontSize={Metric.textDescription} color={Color.secondaryText}/>
      <Label text="Startup" fontSize={Metric.textDescription} color={Color.secondaryText}/>
      <div style="display: flex; flex-direction: row; gap: Metric.space16"><RadioButton text="New canvas" checked={vm.start_new} onToggled={vm.set_start_new}/><RadioButton text="Recent canvas" checked={vm.start_recent} onToggled={vm.set_start_recent}/></div>
      <CheckBox text="Discover nearby Congregation users" checked={vm.discover} onToggled={vm.set_discover}/>
      <Spacer/>
      <Label text={vm.update_status} fontSize={Metric.textDescription}/>
      <div style="display: flex; flex-direction: row; gap: Metric.space8"><Button id="restore-purchases" text="Check license" tone={.default} height={Metric.size28} onClick={vm.restore_license}/><Spacer/><Button id="check-update" text="Check for updates" height={Metric.size28} onClick={vm.check_update}/></div>
    </div>
    <div id="profile-pane" visible={vm.profile_visible} style="display: flex; flex-direction: column; gap: Metric.space12; align-items: stretch; flex: 1">
      <Label text="User image" fontSize={Metric.textDescription} color={Color.secondaryText}/>
      <EventListener id="profile-image" width={Metric.size64} height={Metric.size64} onInput={vm.profile_input}/>
      <Label text="Username" fontSize={Metric.textDescription} color={Color.secondaryText}/>
      <InputField text={vm.display_name} placeholder="Username" width={Metric.size432} onEdited={vm.set_name}/>
      <CheckBox text="Allow inviting other users" checked={vm.can_invite} onToggled={vm.set_can_invite}/>
      <Spacer/>
    </div>
    <div id="members-pane" visible={vm.members_visible} style="display: flex; flex-direction: column; gap: Metric.space8; align-items: stretch; flex: 1">
      <Label text={vm.status} fontSize={Metric.textDescription}/>
      <div style="display: flex; flex-direction: row; gap: Metric.space6"><Button id="host-session" text="Share canvas" tone={.default} height={Metric.size28} onClick={vm.host_session}/><Button id="join-session" text="Join nearby…" tone={.default} height={Metric.size28} onClick={vm.join_session}/><Button id="leave-session" text="Leave" tone={.default} height={Metric.size28} onClick={vm.leave_session}/></div>
      <div style="display: flex; flex-direction: row; gap: Metric.space0; flex: 1; align-items: stretch"><Spacer/><List id="members" model={vm.members} width={Metric.size237} height={Metric.size160} editable={false} reorderable={false} rowHeight={Metric.size20} backgroundColor={Color.popup} selectionColor={Color.memberSelection} selectionRadius={Metric.radius0} onSelectionChanged={vm.select_member}/><Spacer/></div>
      <div style="display: flex; flex-direction: row; gap: Metric.space4"><IconButton accessibilityName="Copy invitation" iconName="add" tone={.borderless} height={Metric.size20} onClick={vm.invite}/><IconButton accessibilityName="Remove member" iconName="remove" tone={.borderless} height={Metric.size20} onClick={vm.remove_member}/><Spacer/><Button text="Accept" tone={.borderless} height={Metric.size20} onClick={vm.accept_invite}/><Button text="Decline" tone={.borderless} height={Metric.size20} onClick={vm.reject_invite}/></div>
    </div>
    <Popover id="join-popup" width={Metric.size344} height={Metric.size132} padding={Metric.space12} surfaceColor={Color.popup}>
      <div style="display: flex; flex-direction: column; gap: Metric.space12; align-items: stretch">
        <Label text="Join canvas" fontSize={Metric.textBody} fontWeight={Metric.weightSemiBold}/>
        <InputField id="session-address" text={vm.session_address} placeholder="Session invitation or host address" width={Metric.size320} height={Metric.size28} onEdited={vm.set_address}/>
        <Button text="Join" height={Metric.size28} onClick={vm.join_submit}/>
      </div>
    </Popover>
    <ContextMenu id="avatar-menu" targetId="profile-image" itemWidth={Metric.size190}>
      <MenuItem keyVisible={false} showChevron={false} label="Select profile image…" onClick={vm.choose_profile}/>
      <MenuItem keyVisible={false} showChevron={false} label="Delete profile image" onClick={vm.clear_profile}/>
    </ContextMenu>
  </div>
</Window>
