import class ToolRow congregation.ui.ToolParameterRow
import panel congregation.ui.ToolPanelBackend

const Compact(row: ToolRow): View = VStack(spacing: Metric.space4, alignment: .stretch) {
    HStack(height: Metric.textDescription, spacing: Metric.space0) {
        Label(text: row.name, fontSize: Metric.textDescription, fontWeight: Metric.weightSemiBold) {},
        Spacer() {},
        Label(text: row.value_label, fontSize: Metric.textCaption) {},
    },
    Slider(id: "slider", from: 0, to: 1, value: row.normalized, enabled: row.enabled,
           accessibilityName: row.name, width: Metric.inspectorWidth - 4 * Metric.space4,
           size: .mini, onMoved: row.move) {},
}

const BrushSize(row: ToolRow): View = VStack(id: "parameter-size", spacing: Metric.space4, alignment: .stretch) {
    HStack(height: Metric.textDescription, spacing: Metric.space0) {
        Label(text: row.name, fontSize: Metric.textDescription, fontWeight: Metric.weightSemiBold) {},
        Spacer() {}, Label(text: row.value_label, fontSize: Metric.textCaption) {},
    },
    Slider(id: "brush-size", from: 0, to: 1, value: row.normalized, enabled: row.enabled,
           accessibilityName: row.name, width: Metric.inspectorWidth - 4 * Metric.space4,
           size: .mini, onMoved: row.move) {},
}

const Detailed(row: ToolRow): View = VStack(spacing: Metric.space2, alignment: .stretch,
                                            topPadding: Metric.space6, bottomPadding: Metric.space6) {
    HStack(height: Metric.size22, alignment: .center) {
        Icon(name: row.icon) {},
        Label(text: row.name, flex: 1) {},
        Label(text: row.value_label, fontSize: Metric.textHeader, fontWeight: Metric.weightSemiBold) {},
        IconButton(iconName: "generalhide", accessibilityName: "Decrease", onClick: row.decrease) {},
        IconButton(iconName: "generaladd", accessibilityName: "Increase", onClick: row.increase) {},
    },
    Slider(id: "slider", from: 0, to: 1, value: row.normalized, enabled: row.enabled,
           accessibilityName: row.name, width: Metric.inspectorWidth - 4 * Metric.space4, onMoved: row.move) {},
    HStack(height: Metric.textCaptionLineHeight) {
        Label(text: row.minimum_label, fontSize: Metric.textCaption) {},
        Spacer() {},
        Label(text: row.maximum_label, fontSize: Metric.textCaption) {},
    },
    MenuDivider(thickness: Metric.stroke1, crossPadding: Metric.space0, dividerColor: Color.canvas) {},
}

const Check(row: ToolRow): View = CheckBox(id: "check", text: row.name, checked: row.checked,
                                            enabled: row.enabled, onToggled: row.toggle) {}
const Choice(row: ToolRow): View = HStack(height: Metric.size20) {
    Label(text: row.choice_label) {}, Spacer() {},
    ListItemSelector(id: "choice", options: row.options, currentIndex: row.choice_index,
                     enabled: row.enabled, accessibilityName: row.name,
                     width: 2 * Metric.size60 + Metric.space16, onCurrentIndexChanged: row.choose) {},
}

Window {
    VStack(id: "tool-panel", spacing: Metric.space4, padding: Metric.space4, alignment: .stretch, flex: 1) {
        VStack(id: "tool-heading", height: Metric.toolHeadingHeight, spacing: Metric.space4, padding: Metric.space4) {
            HStack() {
                Label(text: panel.heading(panel.selected_tool), fontSize: Metric.textHeader, fontWeight: Metric.weightSemiBold) {},
                Spacer() {},
                Label(text: panel.count(panel.selected_tool), fontSize: Metric.textCaption) {},
            },
            ComboBox(id: "brush-preset", text: panel.preset, arrow: .down,
                     visible: panel.is_brush(panel.selected_tool), onClick: panel.choose_preset) {},
            Label(text: "Drag to adjust · − / + for fine steps", fontSize: Metric.textCaption,
                  visible: panel.is_brush(panel.selected_tool)) {},
        },
        ScrollView(id: "tool-scroll", width: Metric.inspectorWidth - 2 * Metric.space4,
                   height: Metric.toolScrollHeight, enabled: !panel.expanded, showIndicator: !panel.expanded, flex: 1) {
            VStack(id: "tool-content", spacing: Metric.space0, alignment: .stretch) {
                VStack(id: "clone-parameters", visible: panel.selected_tool == "clone-stamp", spacing: Metric.space6, padding: Metric.space4) {
                    Label(text: "Alt-click to set source", fontSize: Metric.textCaption) {},
                    CheckBox(id: "clone-aligned", text: "Aligned", checked: panel.clone_aligned) {},
                    CheckBox(id: "clone-current-layer", text: "Current layer only", checked: panel.clone_current_layer) {},
                },
                VStack(id: "tool-parameters", visible: panel.is_brush(panel.selected_tool),
                       spacing: Metric.space16, padding: Metric.space4, alignment: .stretch) {
                    VStack(id: "brush-section", spacing: Metric.space4, leftPadding: Metric.space8 + Metric.space2,
                           rightPadding: Metric.space8 + Metric.space2, alignment: .stretch) {
                        Label(text: "Brush", fontSize: Metric.textDescription, fontWeight: Metric.weightSemiBold) {},
                        BrushSize(row: panel.row("size")) {},
                        Compact(row: panel.row("flow")) {},
                        Compact(row: panel.row("opacity")) {},
                        HStack(id: "tool-pressure-opacity-row", height: Metric.size22) {
                            Label(text: "Pressure Opacity") {}, Spacer() {},
                            ToggleSwitch(id: "tool-pressure-opacity", checked: panel.pressure_enabled, onToggled: panel.set_pressure) {},
                        },
                        Compact(row: panel.row("hardness")) {},
                        VStack(id: "tool-absolute-spacing-block", spacing: Metric.space4) {
                            HStack(id: "tool-absolute-spacing-row") {
                                Label(text: "Spacing") {}, Spacer() {}, Label(text: panel.spacing_label, fontSize: Metric.textCaption) {},
                            },
                            Slider(id: "tool-absolute-spacing", from: 0, to: 64, value: panel.spacing_pixels,
                                   width: Metric.inspectorWidth - 4 * Metric.space4, size: .mini, onMoved: panel.set_spacing) {},
                        },
                        Compact(row: panel.row("spacing")) {},
                        VStack(id: "parameter-stabilization") { Compact(row: panel.row("stabilization")) {}, },
                        Label(text: "Pressure Curve", fontSize: Metric.textDescription) {},
                        EventListener(id: "tool-pressure-curve", width: Metric.inspectorWidth - 4 * Metric.space4,
                                      height: Metric.size92, onInput: panel.curve_input, onResized: panel.curve_resized) {},
                        HStack() { Label(text: "Pressure Minimum", fontSize: Metric.textCaption) {}, Spacer() {}, Label(text: panel.pressure_min_label, fontSize: Metric.textCaption) {}, },
                        HStack() { Label(text: "Pressure Center", fontSize: Metric.textCaption) {}, Spacer() {}, Label(text: panel.pressure_mid_label, fontSize: Metric.textCaption) {}, },
                        HStack() { Label(text: "Pressure Maximum", fontSize: Metric.textCaption) {}, Spacer() {}, Label(text: panel.pressure_max_label, fontSize: Metric.textCaption) {}, },
                    },
                    VStack(id: "shape-dynamics-section", spacing: Metric.space4, leftPadding: Metric.space8 + Metric.space2,
                           rightPadding: Metric.space8 + Metric.space2, alignment: .stretch) {
                        Label(text: "Shape Dynamics", fontSize: Metric.textDescription, fontWeight: Metric.weightSemiBold) {},
                        Compact(row: panel.row("shape-size-jitter")) {}, Choice(row: panel.row("shape-size-control")) {},
                        Compact(row: panel.row("shape-minimum-diameter")) {}, Compact(row: panel.row("shape-tilt-scale")) {},
                        Compact(row: panel.row("shape-angle-jitter")) {}, Choice(row: panel.row("shape-angle-control")) {},
                        Compact(row: panel.row("shape-roundness-jitter")) {}, Choice(row: panel.row("shape-roundness-control")) {},
                        Compact(row: panel.row("shape-minimum-roundness")) {}, Check(row: panel.row("shape-flip-x")) {},
                        Check(row: panel.row("shape-flip-y")) {}, Check(row: panel.row("shape-project")) {},
                    },
                    VStack(id: "scattering-section", spacing: Metric.space4, leftPadding: Metric.space8 + Metric.space2,
                           rightPadding: Metric.space8 + Metric.space2, alignment: .stretch) {
                        Label(text: "Scattering", fontSize: Metric.textDescription, fontWeight: Metric.weightSemiBold) {},
                        Compact(row: panel.row("scatter")) {}, Check(row: panel.row("scatter-both-axes")) {},
                        Choice(row: panel.row("scatter-control")) {}, Compact(row: panel.row("scatter-count")) {},
                        Compact(row: panel.row("scatter-count-jitter")) {}, Choice(row: panel.row("scatter-count-control")) {},
                    },
                    VStack(id: "texture-section", spacing: Metric.space4, leftPadding: Metric.space8 + Metric.space2,
                           rightPadding: Metric.space8 + Metric.space2, alignment: .stretch) {
                        Label(text: "Texture", fontSize: Metric.textDescription, fontWeight: Metric.weightSemiBold) {},
                        HStack(id: "texture-selector", height: Metric.size22) {
                            Label(text: "Texture") {}, Spacer() {},
                            ComboBox(id: "choose-texture", text: panel.texture_name, arrow: .down,
                                     width: 2 * Metric.size60 + Metric.space16, onClick: panel.choose_texture) {},
                            IconButton(id: "add-texture", iconName: "generaladd", onClick: panel.choose_texture) {},
                        },
                        Check(row: panel.row("texture-invert")) {}, Compact(row: panel.row("texture-scale")) {},
                        Compact(row: panel.row("texture-brightness")) {}, Compact(row: panel.row("texture-contrast")) {},
                        Check(row: panel.row("texture-each-tip")) {}, Choice(row: panel.row("texture-mode")) {},
                        Compact(row: panel.row("texture-depth")) {}, Compact(row: panel.row("texture-minimum-depth")) {},
                        Compact(row: panel.row("texture-depth-jitter")) {}, Choice(row: panel.row("texture-depth-control")) {},
                    },
                    VStack(id: "color-dynamics-section", spacing: Metric.space4, leftPadding: Metric.space8 + Metric.space2,
                           rightPadding: Metric.space8 + Metric.space2, alignment: .stretch) {
                        Label(text: "Color Dynamics", fontSize: Metric.textDescription, fontWeight: Metric.weightSemiBold) {},
                        HStack(id: "background-color-row", height: Metric.size30) {
                            Label(text: "Background color") {}, Spacer() {},
                            PushButton(id: "set-background-color", text: "Use current color", onClick: panel.set_background) {},
                        },
                        Check(row: panel.row("color-per-tip")) {}, Compact(row: panel.row("color-mix-jitter")) {},
                        Choice(row: panel.row("color-mix-control")) {}, Compact(row: panel.row("color-hue-jitter")) {},
                        Compact(row: panel.row("color-saturation-jitter")) {}, Compact(row: panel.row("color-brightness-jitter")) {},
                        Compact(row: panel.row("color-purity")) {},
                    },
                    VStack(id: "transfer-section", spacing: Metric.space4, leftPadding: Metric.space8 + Metric.space2,
                           rightPadding: Metric.space8 + Metric.space2, alignment: .stretch) {
                        Label(text: "Transfer", fontSize: Metric.textDescription, fontWeight: Metric.weightSemiBold) {},
                        Compact(row: panel.row("transfer-opacity-jitter")) {},
                        HStack(id: "tool-opacity-control-row", height: Metric.size20) {
                            Label(text: "Control") {}, Spacer() {},
                            ListItemSelector(id: "tool-opacity-control", options: ["Off", "Pen Pressure"],
                                             currentIndex: panel.pressure_enabled ? 1 : 0,
                                             width: 2 * Metric.size60 + Metric.space16,
                                             onCurrentIndexChanged: panel.set_pressure_choice) {},
                        },
                        Detailed(row: panel.row("minimum-opacity")) {}, Detailed(row: panel.row("maximum-opacity")) {},
                        Compact(row: panel.row("transfer-flow-jitter")) {}, Choice(row: panel.row("transfer-flow-control")) {},
                        Compact(row: panel.row("transfer-flow-minimum")) {}, Compact(row: panel.row("transfer-wetness-jitter")) {},
                        Choice(row: panel.row("transfer-wetness-control")) {}, Compact(row: panel.row("transfer-wetness-minimum")) {},
                        Compact(row: panel.row("transfer-mix-jitter")) {}, Choice(row: panel.row("transfer-mix-control")) {},
                        Compact(row: panel.row("transfer-mix-minimum")) {},
                    },
                    VStack(id: "brush-pose-section", spacing: Metric.space4, leftPadding: Metric.space8 + Metric.space2,
                           rightPadding: Metric.space8 + Metric.space2, alignment: .stretch) {
                        Label(text: "Brush Pose", fontSize: Metric.textDescription, fontWeight: Metric.weightSemiBold) {},
                        Compact(row: panel.row("pose-tilt-x")) {}, Check(row: panel.row("pose-override-tilt-x")) {},
                        Compact(row: panel.row("pose-tilt-y")) {}, Check(row: panel.row("pose-override-tilt-y")) {},
                        Compact(row: panel.row("pose-rotation")) {}, Check(row: panel.row("pose-override-rotation")) {},
                        Compact(row: panel.row("pose-pressure")) {}, Check(row: panel.row("pose-override-pressure")) {},
                    },
                    VStack(id: "noise-section", spacing: Metric.space4, leftPadding: Metric.space8 + Metric.space2,
                           rightPadding: Metric.space8 + Metric.space2, alignment: .stretch) {
                        Label(text: "Noise", fontSize: Metric.textDescription, fontWeight: Metric.weightSemiBold) {},
                        Check(row: panel.row("noise-enabled")) {}, Compact(row: panel.row("noise-amount")) {},
                        Compact(row: panel.row("noise-grain-size")) {}, Check(row: panel.row("noise-monochrome")) {},
                    },
                    VStack(id: "wet-edges-section", spacing: Metric.space4, leftPadding: Metric.space8 + Metric.space2,
                           rightPadding: Metric.space8 + Metric.space2, alignment: .stretch) {
                        Label(text: "Wet Edges", fontSize: Metric.textDescription, fontWeight: Metric.weightSemiBold) {},
                        Check(row: panel.row("wet-edges-enabled")) {}, Compact(row: panel.row("wet-edges-strength")) {},
                        Compact(row: panel.row("wet-edges-width")) {}, Compact(row: panel.row("wet-edges-diffusion")) {},
                    },
                    VStack(id: "build-up-section", spacing: Metric.space4, leftPadding: Metric.space8 + Metric.space2,
                           rightPadding: Metric.space8 + Metric.space2, alignment: .stretch) {
                        Label(text: "Build-up", fontSize: Metric.textDescription, fontWeight: Metric.weightSemiBold) {},
                        Check(row: panel.row("build-up-enabled")) {}, Compact(row: panel.row("build-up-rate")) {},
                        Compact(row: panel.row("build-up-limit")) {}, Check(row: panel.row("build-up-time")) {},
                    },
                    VStack(id: "smoothing-section", spacing: Metric.space4, leftPadding: Metric.space8 + Metric.space2,
                           rightPadding: Metric.space8 + Metric.space2, alignment: .stretch) {
                        Label(text: "Smoothing", fontSize: Metric.textDescription, fontWeight: Metric.weightSemiBold) {},
                        Check(row: panel.row("smoothing-enabled")) {}, Choice(row: panel.row("smoothing-method")) {},
                        Label(text: "Strength: Brush / Smoothing Strength", fontSize: Metric.textCaption) {},
                        Detailed(row: panel.row("post")) {}, Check(row: panel.row("smoothing-catch-up")) {},
                    },
                    VStack(id: "tip-spacing-section", spacing: Metric.space4, alignment: .stretch) {
                        Label(text: "Tip & spacing", fontSize: Metric.textDescription, fontWeight: Metric.weightSemiBold) {},
                        Detailed(row: panel.row("roundness")) {}, Detailed(row: panel.row("angle")) {}, Detailed(row: panel.row("count")) {},
                    },
                    VStack(id: "dynamics-section", spacing: Metric.space4, alignment: .stretch) {
                        Label(text: "Dynamics", fontSize: Metric.textDescription, fontWeight: Metric.weightSemiBold) {},
                        Detailed(row: panel.row("pressure")) {},
                        VStack(id: "parameter-tilt") { Detailed(row: panel.row("tilt")) {}, },
                    },
                    VStack(id: "paint-mixing-section", spacing: Metric.space4, alignment: .stretch) {
                        Label(text: "Paint & mixing", fontSize: Metric.textDescription, fontWeight: Metric.weightSemiBold) {},
                        Detailed(row: panel.row("wetness")) {}, Detailed(row: panel.row("mix")) {},
                        Detailed(row: panel.row("load")) {}, Detailed(row: panel.row("dilution")) {},
                    },
                    VStack(id: "taper-limits-section", spacing: Metric.space4, alignment: .stretch) {
                        Label(text: "Taper & limits", fontSize: Metric.textDescription, fontWeight: Metric.weightSemiBold) {},
                        Detailed(row: panel.row("start")) {}, Detailed(row: panel.row("end")) {},
                        Detailed(row: panel.row("minimum-size")) {},
                        VStack(id: "parameter-taper") { Detailed(row: panel.row("taper")) {}, },
                    },
                },
                VStack(id: "polygon-parameters", visible: panel.is_shape(panel.selected_tool), spacing: Metric.space6, padding: Metric.space4) {
                    HStack(visible: panel.selected_tool == "polygon") { Label(text: "Sides") {}, Spacer() {}, Label(text: panel.integer(panel.polygon_sides)) {}, },
                    Slider(id: "polygon-sides", visible: panel.selected_tool == "polygon", from: 3, to: 64, value: panel.polygon_sides, onMoved: panel.set_polygon_sides) {},
                    HStack(visible: panel.selected_tool == "polygon") { Label(text: "Rotation") {}, Spacer() {}, Label(text: panel.degrees(panel.polygon_rotation)) {}, },
                    Slider(id: "polygon-rotation", visible: panel.selected_tool == "polygon", from: -180, to: 180, value: panel.polygon_rotation) {},
                    CheckBox(id: "polygon-center", text: "Draw from center", checked: panel.polygon_center) {},
                    CheckBox(id: "polygon-fill", text: "Fill", checked: panel.polygon_fill) {},
                    CheckBox(id: "polygon-outline", text: "Outline", checked: panel.polygon_outline) {},
                    HStack() { Label(text: "Outline width") {}, Spacer() {}, Label(text: panel.pixels(panel.polygon_stroke_width)) {}, },
                    Slider(id: "polygon-stroke-width", from: 0, to: 64, value: panel.polygon_stroke_width) {},
                    HStack() { Label(text: "Opacity") {}, Spacer() {}, Label(text: panel.percentage(panel.polygon_opacity)) {}, },
                    Slider(id: "polygon-opacity", from: 0, to: 1, value: panel.polygon_opacity) {},
                    Label(text: "Shift: constrain proportions", fontSize: Metric.textCaption) {},
                },
                VStack(id: "selection-parameters", visible: panel.is_selection(panel.selected_tool), spacing: Metric.space6, padding: Metric.space4) {
                    HStack() { Label(text: "Feather") {}, Spacer() {}, Label(text: panel.pixels(panel.selection_feather)) {}, },
                    Slider(id: "selection-feather", from: 0, to: 32, value: panel.selection_feather) {},
                    CheckBox(id: "selection-antialias", text: "Antialias", checked: panel.selection_antialias) {},
                    HStack(visible: panel.selected_tool == "magnetic-lasso") { Label(text: "Edge radius") {}, Spacer() {}, Label(text: panel.pixels(panel.magnetic_radius)) {}, },
                    Slider(id: "magnetic-radius", visible: panel.selected_tool == "magnetic-lasso", from: 2, to: 64, value: panel.magnetic_radius) {},
                    Label(text: "Shift: add · Alt: subtract · Shift + Alt: intersect", fontSize: Metric.textCaption) {},
                },
                VStack(id: "crop-parameters", visible: panel.selected_tool == "crop" || panel.selected_tool == "perspective-crop",
                       spacing: Metric.space6, padding: Metric.space4) {
                    HStack() { Label(text: "Aspect ratio") {}, Spacer() {},
                        PushButton(id: "crop-aspect", text: panel.aspect_label(panel.crop_aspect), onClick: panel.cycle_crop_aspect) {}, },
                    Label(text: "Drag a rectangle; move it or drag a corner", fontSize: Metric.textCaption) {},
                    PushButton(id: "crop-mode", visible: panel.selected_tool == "crop", text: panel.crop_mode_label(panel.crop_destructive),
                               onClick: panel.toggle_crop_mode) {},
                    Label(visible: panel.selected_tool == "crop", fontSize: Metric.textCaption,
                          text: panel.crop_destructive ? "Rasterizes all layers and removes replaced sources · all frames" : "Non-destructive · applies to all frames") {},
                    Label(visible: panel.selected_tool == "perspective-crop", fontSize: Metric.textCaption,
                          text: "Rectifies and rasterizes layers · all frames") {},
                    HStack() {
                        PushButton(id: "crop-apply", text: "Apply", onClick: panel.apply_crop) {},
                        PushButton(id: "crop-cancel", text: "Cancel", onClick: panel.cancel_crop) {},
                    },
                },
                VStack(id: "wand-parameters", visible: panel.selected_tool == "magic-wand", spacing: Metric.space6, padding: Metric.space4) {
                    HStack() { Label(text: "Tolerance") {}, Spacer() {}, Label(text: panel.percentage(panel.wand_tolerance)) {}, },
                    Slider(id: "wand-tolerance", from: 0, to: 1, value: panel.wand_tolerance) {},
                    CheckBox(id: "wand-contiguous", text: "Contiguous", checked: panel.wand_contiguous) {},
                    CheckBox(id: "wand-current-layer", text: "Current layer only", checked: panel.wand_current_layer) {},
                    Label(text: "Shift: add · Alt: subtract · Shift + Alt: intersect", fontSize: Metric.textCaption) {},
                },
                VStack(id: "fill-parameters", visible: panel.selected_tool == "paint-bucket", spacing: Metric.space6, padding: Metric.space4) {
                    HStack() { Label(text: "Tolerance") {}, Spacer() {}, Label(text: panel.percentage(panel.fill_tolerance)) {}, },
                    Slider(id: "fill-tolerance", from: 0, to: 1, value: panel.fill_tolerance) {},
                    CheckBox(id: "fill-contiguous", text: "Contiguous", checked: panel.fill_contiguous) {},
                    CheckBox(id: "fill-antialias", text: "Antialias boundary", checked: panel.fill_antialias) {},
                    CheckBox(id: "fill-current-layer", text: "Current layer only", checked: panel.fill_current_layer) {},
                    CheckBox(id: "fill-target-current", text: "Edit current layer", checked: panel.fill_target_current) {},
                    CheckBox(id: "fill-preserve-alpha", text: "Preserve layer alpha", checked: panel.fill_preserve_alpha, enabled: panel.fill_target_current) {},
                    Label(text: "Direct edits affect only the current frame", fontSize: Metric.textCaption) {},
                },
                VStack(id: "gradient-parameters", visible: panel.selected_tool == "gradient", spacing: Metric.space6, padding: Metric.space4) {
                    HStack() {
                        Label(text: panel.gradient_stop(panel.gradient_revision)) {}, Spacer() {},
                        IconButton(id: "gradient-previous-stop", iconName: "generalhide", onClick: panel.gradient_previous) {},
                        IconButton(id: "gradient-next-stop", iconName: "generaladd", onClick: panel.gradient_next) {},
                        IconButton(id: "gradient-add-stop", iconName: "generaladd", onClick: panel.gradient_add) {},
                        IconButton(id: "gradient-remove-stop", iconName: "generalhide", onClick: panel.gradient_remove) {},
                    },
                    HStack() { Label(text: "Position") {}, Spacer() {}, Label(text: panel.percentage(panel.gradient_position(panel.gradient_revision))) {}, },
                    Slider(id: "gradient-stop-position", from: 0, to: 1, value: panel.gradient_position(panel.gradient_revision),
                           enabled: panel.gradient_position_enabled(panel.gradient_revision), onMoved: panel.set_gradient_position) {},
                    HStack() { Label(text: panel.gradient_color(panel.gradient_revision)) {}, Spacer() {},
                        PushButton(id: "gradient-use-current-color", text: "Use picker color", onClick: panel.gradient_use_current_color) {}, },
                    HStack() { Label(text: "Stop opacity") {}, Spacer() {}, Label(text: panel.percentage(panel.gradient_alpha(panel.gradient_revision))) {}, },
                    Slider(id: "gradient-stop-alpha", from: 0, to: 1, value: panel.gradient_alpha(panel.gradient_revision), onMoved: panel.set_gradient_alpha) {},
                    CheckBox(id: "gradient-radial", text: "Radial", checked: panel.gradient_radial(panel.gradient_revision), onToggled: panel.set_gradient_radial) {},
                    CheckBox(id: "gradient-repeat", text: "Repeat", checked: panel.gradient_repeat(panel.gradient_revision), onToggled: panel.set_gradient_repeat) {},
                    HStack() { Label(text: "Blend") {}, Spacer() {}, Label(text: panel.gradient_blend(panel.gradient_revision)) {},
                        PushButton(id: "gradient-blend", text: "Next", onClick: panel.cycle_gradient_blend) {}, },
                },
            },
        },
        HStack(id: "tool-actions", visible: panel.is_brush(panel.selected_tool), height: Metric.size30 + 2 * Metric.space4,
               spacing: Metric.space6, padding: Metric.space4) {
            IconSegmentedControl(id: "brush-dynamics") {
                IconButton(id: "pressure-enabled", iconName: "brush-pressure", onClick: panel.toggle_pressure) {},
                IconButton(id: "tilt-detail", iconName: "panel-tilt-angle", onClick: panel.reveal_tilt) {},
                IconButton(id: "smoothing-detail", iconName: "brush-smoothing", onClick: panel.reveal_smoothing) {},
                IconButton(id: "clone-source", iconName: "clone-source", onClick: panel.select_clone) {},
            },
            Spacer() {},
            IconButton(id: "reset-tool", iconName: "generalundo", onClick: panel.reset) {},
            IconButton(id: "save-tool", iconName: "generalsave", onClick: panel.save) {},
        },
    },
}
