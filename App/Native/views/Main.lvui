                            IconButton(id: "tool-gradient", iconName: "gradient", accessibilityName: "gradient", tone: vm.selected_tool == "gradient" ? vm.active_tool_tone : vm.inactive_tool_tone, onClick: vm.choose_tool_gradient) {},
