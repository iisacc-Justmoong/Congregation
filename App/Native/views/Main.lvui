                        Slider(id: "brush-flow-popup", from: 0, to: 1, value: vm.flow, width: Metric.size340 - 2 * Metric.space12, size: .mini, onMoved: vm.set_flow) {},
                    },
                    VStack(spacing: Metric.space4, alignment: .stretch) {
                        HStack() {
                            Label(text: "Opacity") {},
                            Spacer() {},
                            Label(text: vm.opacity_label) {},
                        },
                        Slider(id: "brush-opacity-popup", from: 0, to: 1, value: vm.opacity, width: Metric.size340 - 2 * Metric.space12, size: .mini, onMoved: vm.set_opacity) {},
                    },
                    HStack(alignment: .center) {
                        Label(text: "Pressure Opacity", flex: 1) {},
                        ToggleSwitch(checked: vm.pressure_enabled, onToggled: vm.set_pressure_enabled) {},
                    },
                    VStack(spacing: Metric.space4, alignment: .stretch) {
                        HStack() {
                            Label(text: "Hardness") {},
                            Spacer() {},
                            Label(text: vm.hardness_label) {},
                        },
                        Slider(id: "brush-hardness-popup", from: 0.01, to: 1, value: vm.hardness, width: Metric.size340 - 2 * Metric.space12, size: .mini, onMoved: vm.set_hardness) {},
                    },
                    VStack(spacing: Metric.space4, alignment: .stretch) {
                        HStack() {
                            Label(text: "Spacing") {},
                            Spacer() {},
                            Label(text: vm.spacing_label) {},
                        },
                        Slider(id: "brush-spacing-popup", from: 0, to: 64, value: vm.spacing_pixels, width: Metric.size340 - 2 * Metric.space12, size: .mini, onMoved: vm.set_spacing_pixels) {},
                    },
                    VStack(spacing: Metric.space4, alignment: .stretch) {
                        HStack() {
                            Label(text: "Spacing Ratio") {},
                            Spacer() {},
                            Label(text: vm.spacing_ratio_label) {},
                        },
                        Slider(id: "brush-spacing-ratio-popup", from: 0, to: 1, value: vm.spacing, width: Metric.size340 - 2 * Metric.space12, size: .mini, onMoved: vm.set_spacing) {},
                    },
                    VStack(spacing: Metric.space4, alignment: .stretch) {
                        HStack() {
                            Label(text: "Smoothing Strength") {},
                            Spacer() {},
                            Label(text: vm.stabilizer_label) {},
                        },
                        Slider(id: "brush-stabilizer-popup", from: 0, to: 1, value: vm.stabilizer, width: Metric.size340 - 2 * Metric.space12, size: .mini, onMoved: vm.set_stabilizer) {},
                    },
                    VStack(spacing: Metric.space4, alignment: .stretch) {
                        Label(text: "Pressure Curve") {},
                        EventListener(id: "pressure-curve", width: Metric.size340 - 2 * Metric.space12, height: Metric.size92, onInput: vm.pressure_curve_input) {},
                        HStack() {
                            Label(text: "Pressure Minimum", style: .caption) {},
                            Spacer() {},
                            Label(text: vm.pressure_min_label, style: .caption) {},
                        },
                        HStack() {
                            Label(text: "Pressure Center", style: .caption) {},
                            Spacer() {},
                            Label(text: vm.pressure_mid_label, style: .caption) {},
                        },
                        HStack() {
                            Label(id: "pressure-maximum-label", text: "Pressure Maximum", style: .caption) {},
                            Spacer() {},
                            Label(text: vm.pressure_max_label, style: .caption) {},
                        },
                    },
                },
            },
        },
    },
}
