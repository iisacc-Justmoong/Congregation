<script>
import vm congregation.ui.EditorBackend
</script>
<ApplicationWindow title="Congregation" width={Metric.windowWidth} height={Metric.windowHeight} minimumWidth={Metric.windowMinimumWidth} minimumHeight={Metric.windowMinimumHeight}>
  <div id="activation-shell" style=" display: flex; flex-direction: column; gap: Metric.space0; align-items: stretch; flex: 1">
    <div visible={vm.needs_license} style="display: flex; flex-direction: column; align-items: center; flex: 1">
    <Spacer/>
    <AppCard id="activation" width={Metric.size540} height={Metric.size340}>
      <div style="display: flex; flex-direction: column; gap: Metric.space12; align-items: stretch">
      <Label text="Sign in to Congregation" fontSize={Metric.font24} fontWeight={Metric.weightSemiBold}/>
      <Label text="Use your iisacc account. Your browser opens the secure sign-in page." fontSize={Metric.textBody}/>
      <div style="display: flex; flex-direction: row; gap: Metric.space12"><Label text="Account" fontSize={Metric.textDescription}/><Spacer/><Label text={vm.account_email} fontSize={Metric.textBody}/></div>
      <Label text="Accounts, connected devices and licenses are managed in Society." fontSize={Metric.textDescription}/>
      <Label id="account-status" text={vm.account_status} fontSize={Metric.textDescription}/>
      <Button id="account-open-society" text="Open Society" onClick={vm.open_society}/>
      <Button id="activate" text="Sign in at iisacc.com" enabled={vm.can_activate} onClick={vm.activate}/>
      <div style="display: flex; flex-direction: row; gap: Metric.space8">
        <Button id="refresh-license" visible={vm.signed_in} text="Check license again" enabled={vm.can_activate} onClick={vm.restore_license}/>
        <Button id="cancel-sign-in" visible={vm.signing_in} text="Cancel" onClick={vm.cancel_sign_in}/>
        <Button id="sign-out" visible={vm.signed_in} text="Sign out" onClick={vm.forget_license}/>
      </div>
      </div>
    </AppCard>
    <Spacer/>
    </div>
    <ContextMenu id="shape-menu" itemWidth={Metric.size180}>
      <MenuItem keyVisible={false} showChevron={false} id="rectangle" label="Rectangle" iconName="rectangle" onClick={vm.rectangle}/>
      <MenuItem keyVisible={false} showChevron={false} id="ellipse" label="Ellipse" iconName="ellipse" onClick={vm.ellipse}/>
      <MenuItem keyVisible={false} showChevron={false} id="triangle" label="Triangle" iconName="triangle" onClick={vm.triangle}/>
      <MenuItem keyVisible={false} showChevron={false} label="Diamond" iconName="diamond" onClick={vm.diamond}/>
      <MenuItem keyVisible={false} showChevron={false} label="Star" iconName="star" onClick={vm.star}/>
      <MenuItem keyVisible={false} showChevron={false} iconName="rectangle" label="Rectangle bubble" onClick={vm.rectanglebubble}/>
      <MenuItem keyVisible={false} showChevron={false} iconName="ellipse" label="Ellipse bubble" onClick={vm.ellipsebubble}/>
    </ContextMenu>
    <ContextMenu id="color-actions" itemWidth={Metric.size200}>
      <MenuItem keyVisible={false} showChevron={false} label="Brush color…" onClick={vm.open_color}/>
      <MenuItem keyVisible={false} showChevron={false} label="Preferences…" onClick={vm.preferences}/>
      <MenuItem keyVisible={false} showChevron={false} label="Presentation" onClick={vm.presentation}/>
    </ContextMenu>
    <ContextMenu id="layer-menu" itemWidth={Metric.size180}>
      <MenuItem keyVisible={false} showChevron={false} label="Add layer" onClick={vm.add_layer}/>
      <MenuItem keyVisible={false} showChevron={false} id="menu-duplicate-layer" label="Duplicate layer" onClick={vm.duplicate_layer}/>
      <MenuItem keyVisible={false} showChevron={false} label="Delete layer" onClick={vm.delete_layer}/>
      <MenuItem keyVisible={false} showChevron={false} label="Show / hide layer" onClick={vm.toggle_layer_visibility}/>
      <MenuDivider/>
      <MenuItem keyVisible={false} showChevron={false} label="Place image…" onClick={vm.image}/>
    </ContextMenu>
    <Popover id="color-popup" width={Metric.size320} height={Metric.size320} padding={Metric.space20} surfaceColor={Color.popup} cornerRadius={Metric.radius8}>
      <ColorPickerSurface id="color-editor" model={vm.color} field={.wheel} width={Metric.size280} height={Metric.size280}/>
    </Popover>
    <Popover id="status-notice" width={Metric.size420} height={Metric.size98} padding={Metric.space12} focus={false} clip={true} surfaceColor={Color.popup} accessibilityName="Canvas error">
      <div style="display: flex; flex-direction: row; gap: Metric.space8; align-items: center"><Label text={vm.status} fontSize={Metric.textDescription} flex={1}/><LabelButton text="×" tone={.borderless} height={Metric.size22} horizontalPadding={Metric.space4} accessibilityName="Dismiss message" onClick={vm.close_notice}/></div>
    </Popover>
    <Popover id="text-popup" width={Metric.size320} height={Metric.size118} padding={Metric.space12} surfaceColor={Color.popup} cornerRadius={Metric.radius8}>
      <div style="display: flex; flex-direction: column; gap: Metric.space8">
        <Label text="Text" fontSize={Metric.textBody} fontWeight={Metric.weightSemiBold}/>
        <InputField id="text-value" multiline={true} height={Metric.size64} text={vm.text_value} placeholder="Text to place" width={Metric.size296} onEdited={vm.set_text}/>
      </div>
    </Popover>
    <Popover id="brush-popup" width={Metric.size340} height={Metric.size574} padding={Metric.space12} clip={true} surfaceColor={Color.popup} cornerRadius={Metric.radius8}>
      <div style="display: flex; flex-direction: column; gap: Metric.space12; align-items: stretch">
        <Label text="Brush" fontSize={Metric.textBody} fontWeight={Metric.weightBold}/>
        <div style="display: flex; flex-direction: column; gap: Metric.space4; align-items: stretch">
          <div style="display: flex; flex-direction: row"><Label text="Size" fontSize={Metric.textDescription}/><Spacer/><Label text={vm.size_label} fontSize={Metric.textDescription}/></div>
          <Slider from={1} to={48} value={vm.brush_size} width={Metric.size316} height={Metric.size12} thumbDiameter={Metric.size12} trackHeight={Metric.size4} rangeInset={Metric.space6} onMoved={vm.set_brush_size}/>
        </div>
        <div style="display: flex; flex-direction: column; gap: Metric.space4; align-items: stretch">
          <div style="display: flex; flex-direction: row"><Label text="Flow" fontSize={Metric.textDescription}/><Spacer/><Label text={vm.flow_label} fontSize={Metric.textDescription}/></div>
          <Slider from={0} to={1} value={vm.flow} width={Metric.size316} height={Metric.size12} thumbDiameter={Metric.size12} trackHeight={Metric.size4} rangeInset={Metric.space6} onMoved={vm.set_flow}/>
        </div>
        <div style="display: flex; flex-direction: column; gap: Metric.space4; align-items: stretch">
          <div style="display: flex; flex-direction: row"><Label text="Opacity" fontSize={Metric.textDescription}/><Spacer/><Label text={vm.opacity_label} fontSize={Metric.textDescription}/></div>
          <Slider from={0} to={1} value={vm.opacity} width={Metric.size316} height={Metric.size12} thumbDiameter={Metric.size12} trackHeight={Metric.size4} rangeInset={Metric.space6} onMoved={vm.set_opacity}/>
        </div>
        <div style="display: flex; flex-direction: row; align-items: center"><Label text="Pressure Opacity" fontSize={Metric.textDescription} flex={1}/><ToggleSwitch checked={vm.pressure_enabled} onToggled={vm.set_pressure_enabled}/></div>
        <div style="display: flex; flex-direction: column; gap: Metric.space4; align-items: stretch">
          <div style="display: flex; flex-direction: row"><Label text="Hardness" fontSize={Metric.textDescription}/><Spacer/><Label text={vm.hardness_label} fontSize={Metric.textDescription}/></div>
          <Slider from={0.01} to={1} value={vm.hardness} width={Metric.size316} height={Metric.size12} thumbDiameter={Metric.size12} trackHeight={Metric.size4} rangeInset={Metric.space6} onMoved={vm.set_hardness}/>
        </div>
        <div style="display: flex; flex-direction: column; gap: Metric.space4; align-items: stretch">
          <div style="display: flex; flex-direction: row"><Label text="Spacing" fontSize={Metric.textDescription}/><Spacer/><Label text={vm.spacing_label} fontSize={Metric.textDescription}/></div>
          <Slider from={0} to={64} value={vm.spacing_pixels} width={Metric.size316} height={Metric.size12} thumbDiameter={Metric.size12} trackHeight={Metric.size4} rangeInset={Metric.space6} onMoved={vm.set_spacing_pixels}/>
        </div>
        <div style="display: flex; flex-direction: column; gap: Metric.space4; align-items: stretch">
          <div style="display: flex; flex-direction: row"><Label text="Spacing Ratio" fontSize={Metric.textDescription}/><Spacer/><Label text={vm.spacing_ratio_label} fontSize={Metric.textDescription}/></div>
          <Slider from={0} to={1} value={vm.spacing} width={Metric.size316} height={Metric.size12} thumbDiameter={Metric.size12} trackHeight={Metric.size4} rangeInset={Metric.space6} onMoved={vm.set_spacing}/>
        </div>
        <div style="display: flex; flex-direction: column; gap: Metric.space4; align-items: stretch">
          <div style="display: flex; flex-direction: row"><Label text="Stabilizer" fontSize={Metric.textDescription}/><Spacer/><Label text={vm.stabilizer_label} fontSize={Metric.textDescription}/></div>
          <Slider from={0} to={1} value={vm.stabilizer} width={Metric.size316} height={Metric.size12} thumbDiameter={Metric.size12} trackHeight={Metric.size4} rangeInset={Metric.space6} onMoved={vm.set_stabilizer}/>
        </div>
        <div style="display: flex; flex-direction: column; gap: Metric.space8; align-items: stretch">
          <Label text="Pressure Curve" fontSize={Metric.textDescription}/>
          <EventListener id="pressure-curve" width={Metric.size316} height={Metric.size92} onInput={vm.pressure_curve_input}/>
          <div style="display: flex; flex-direction: row"><Label text="Pressure Minimum" fontSize={Metric.textCaption}/><Spacer/><Label text={vm.pressure_min_label} fontSize={Metric.textCaption}/></div>
          <div style="display: flex; flex-direction: row"><Label text="Pressure Center" fontSize={Metric.textCaption}/><Spacer/><Label text={vm.pressure_mid_label} fontSize={Metric.textCaption}/></div>
          <div style="display: flex; flex-direction: row"><Label text="Pressure Maximum" fontSize={Metric.textCaption}/><Spacer/><Label text={vm.pressure_max_label} fontSize={Metric.textCaption}/></div>
        </div>
      </div>
    </Popover>
  </div>
</ApplicationWindow>
